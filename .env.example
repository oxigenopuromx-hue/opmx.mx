# URL pública del sitio, usada para metadataBase, canonical, robots.txt y
# sitemap.xml. Sin definir, se usa el dominio de producción declarado en el
# Master Spec (https://opmx.com.mx). Defínela en staging/preview para que
# esas rutas apunten al entorno correcto en vez de a producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Barrera Basic Auth temporal de staging (ver STAGING.md). Define AMBAS para
# activarla; sin ellas el sitio queda abierto (comportamiento normal en
# desarrollo local y CI). NO es el sistema de identidad definitivo de OPMX.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
